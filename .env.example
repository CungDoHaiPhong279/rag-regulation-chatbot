# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.
# Chuỗi rỗng = không đặt.

# --- Qdrant ---
# Docker (môi trường chính): docker compose up -d
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Đặt đường dẫn thư mục để dùng local mode (không cần Docker, chỉ 1 tiến trình được mở)
QDRANT_PATH=
QDRANT_COLLECTION=regulations

# --- Model ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- LLM (Gemini) ---
GEMINI_API_KEY=
# Tên model Gemini (ví dụ dòng Flash); ghi rõ trong báo cáo đánh giá
GEMINI_MODEL=
LLM_TIMEOUT_S=30

# --- Chunking: đơn vị KÝ TỰ, tính cả tiền tố "Điều X. Tên: " ---
# Giá trị khởi đầu, chọn lại bằng Recall@5 trên tập dev (400/800/1200).
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- BM25 ---
BM25_K1=1.2
BM25_B=0.75

# --- Truy xuất ---
# Số ứng viên lấy từ hybrid search trước khi rerank, và số chunk đưa vào LLM
CANDIDATE_K=20
FINAL_K=5
# Lớp chống bịa 1: điểm rerank cao nhất thấp hơn ngưỡng -> từ chối không gọi LLM.
# Giá trị khởi đầu, chỉnh trên tập dev.
RERANK_THRESHOLD=0.3

# Ghi toàn văn câu hỏi vào log (chỉ dùng khi gỡ lỗi)
DEBUG=false
